.app { padding: 32rpx 28rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.header { display: flex; align-items: center; margin-bottom: 32rpx; }
.logo { width: 112rpx; height: 112rpx; background: #fff; border-radius: 32rpx; font-size: 68rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.title { font-size: 48rpx; font-weight: 600; }
.subtitle { color: #888; font-size: 26rpx; margin-top: 8rpx; }
.status-card { display: flex; align-items: center; padding: 24rpx 32rpx; background: #fff; border-radius: 24rpx; font-size: 28rpx; }
.status-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #aaa; margin-right: 22rpx; }
.listening { background: #36b37e; }.thinking { background: #f5a623; }.speaking { background: #4c8bf5; }.error { background: #e55353; }
.conversation { height: 52vh; min-height: 400rpx; background: rgba(255,255,255,.85); border-radius: 32rpx; margin: 28rpx 0; }
.empty-state { min-height: 400rpx; height: 52vh; padding: 32rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #999; font-size: 28rpx; }
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.message { display: flex; flex-direction: column; padding: 24rpx 28rpx 0; }
.message:last-of-type { padding-bottom: 24rpx; }
.message.user { align-items: flex-end; }.message.assistant { align-items: flex-start; }
.message-label { font-size: 24rpx; color: #999; margin-bottom: 10rpx; }
.message-content { max-width: 90%; padding: 20rpx 26rpx; border-radius: 24rpx; font-size: 30rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.user .message-content { background: #e9f4ff; }.assistant .message-content { background: #fff4dc; }
.controls button { border-radius: 26rpx; font-size: 32rpx; font-weight: 600; }
.start-button { background: #333; color: #fff; }.stop-button { background: #eee; color: #333; }
.connection-card { margin-top: 28rpx; padding: 24rpx 28rpx; background: rgba(255,255,255,.7); border-radius: 24rpx; font-size: 24rpx; color: #666; word-break: break-all; }
.connection-title { margin-bottom: 10rpx; color: #999; }
.settings-button { margin-top: 20rpx; background: transparent; color: #888; font-size: 24rpx; }
